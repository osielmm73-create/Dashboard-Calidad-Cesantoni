rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quality_data/{docId} {
      // Cualquiera con el link del dashboard puede leer los datos.
      allow read: if true;
      // Solo se puede escribir si hay una sesión de Firebase Authentication
      // activa (login con correo/contraseña desde el propio dashboard).
      allow write: if request.auth != null;
    }
  }
}
